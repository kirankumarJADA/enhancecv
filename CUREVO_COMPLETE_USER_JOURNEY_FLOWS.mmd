sequenceDiagram
  autonumber
  title Journey 6: Job Discovery, Real-time Fit Scoring & Kanban Handoff

  actor User as Candidate
  participant Web as Jobs.tsx (/jobs)
  participant API as Express Router (/api/public/jobs)
  participant JobSource as jobSource.ts (Adzuna / Reed / Presets)
  participant Match as Match Engine (/api/public/match)
  participant Storage as LocalStorage

  User->>Web: Opens /jobs, enters "Senior React Engineer", filters "Remote"
  Web->>API: GET /api/public/jobs/status
  API-->>Web: 200 OK { configured: true, provider: "Adzuna UK" }
  Web->>API: POST /api/public/jobs/discover { query: "Senior React Engineer", remoteType: "remote" }
  API->>JobSource: searchJobsWithCache(preferences) (10m memory TTL)
  JobSource-->>API: 20 normalized DiscoveredJob listings
  API-->>Web: 200 OK { jobs, total, source: "adzuna" }
  Web-->>User: Renders job cards

  User->>Web: Clicks "Calculate Fit" on a vacancy card
  Web->>Storage: loadActiveDraftResume() reads CV draft
  Web->>API: POST /api/public/match { resume: activeResume, jobText: vacancy.description }
  API->>Match: computeJobMatch()
  Match-->>API: MatchAnalysis { score: 86, matchedSkills, missingSkills }
  API-->>Web: 200 OK { match }
  Web-->>User: Displays 86% match badge on card

  User->>Web: Clicks "Save Job"
  Web->>Storage: saveJob(jobWithScore) appends to "curevo_saved_jobs_v1"
  User->>Web: Clicks "Prepare Application"
  Web->>Storage: createApplicationFromJob(job) saves to "curevo_applications_v1"
  Web->>Web: Navigates to /prepare-application?jobId=...

