sequenceDiagram
  autonumber
  title Journey 7: Interactive Kanban Application Pipeline Tracking

  actor User as Candidate
  participant Web as Applications.tsx (/applications)
  participant Storage as LocalStorage (curevo_applications_v1)
  participant Research as CompanyResearchModal.tsx
  participant API as Express Router (/api/public)

  User->>Web: Opens /applications
  Web->>Storage: getApplications() loads application records
  Storage-->>Web: Array of TrackedApplication objects
  Web-->>User: Renders 5-column Kanban (Saved, Applied, Interview, Offer, Rejected)

  User->>Web: Drags card from "Saved" to "Interview" column
  Web->>Storage: updateApplicationStatus(id, "INTERVIEW") updates record
  Web-->>User: Card snaps into "Interview" column; updates metrics

  User->>Web: Clicks "Research Company" on an application card
  Web->>Research: Opens CompanyResearchModal for "Nomos Bank"
  Research->>Storage: getCompanyResearch("Nomos Bank") checks cache
  
  alt In Cache
    Storage-->>Research: Cached company intelligence
  else Not in Cache
    Research->>API: POST /api/public/company-research { company: "Nomos Bank" }
    API-->>Research: 200 OK { research: { products, culture, interviewTips } }
    Research->>Storage: saveCompanyResearch("Nomos Bank", data)
  end
  Research-->>User: Displays verified business model, interview questions, culture tips

  User->>Web: Clicks "Export CSV"
  Web->>Web: Generates CSV blob and triggers download "curevo-job-applications-YYYY-MM-DD.csv"

