# Curevo AI server environment variables.
# Copy to .env and fill in real values. NEVER commit .env to source control.

# --- Database (required) -------------------------------------------------
# Supabase: Project Settings > Database > Connection string (URI, session pooler)
# Render/Render-hosted Postgres: the Internal Database URL
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# TLS for the database connection (optional).
# Default: enabled for any non-localhost host, disabled for localhost.
# Set explicitly to override: DATABASE_SSL=true | false
# DATABASE_SSL=true

# --- Local development PostgreSQL (Docker) -------------------------------
#   docker compose up -d
# then use:
# DATABASE_URL=postgres://postgres:ecvlocal@localhost:5434/enhancecv

# --- Auth (required in production) ---------------------------------------
# Secret used to sign session JWTs. Generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# --- Server ---------------------------------------------------------------
PORT=4000
# Public URL of the web app — used in verification/reset email links.
# APP_URL=https://app.yourdomain.com
# NODE_ENV=production

# When set, the server also serves the built frontend from this directory
# (single-service deployment, e.g. Render with a combined build).
# WEB_DIST=../web/dist

# --- Admin bootstrap --------------------------------------------------------
# Comma-separated emails promoted to ADMIN at server start (empty = none).
# ADMIN_EMAILS=admin@yourdomain.com

# --- Optional AI enhancement (Curevo AI Resume Agent) ---------------------
# The deterministic ATS/JD/matching/tailoring engines work fully without a
# key. When configured, the AI Resume Agent adds one structured tailoring
# proposal + a bounded critique loop on top — every AI claim is validated by
# the deterministic Truth Guard before it can reach a resume.
# Keys are server-side only and are never exposed to the frontend.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (default: https://api.openai.com/v1)
# AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_ITERATIONS=2

# --- Plans & quotas (optional overrides; defaults in src/lib/plans.ts) -----
# PLAN_FREE_TAILORING=5
# PLAN_FREE_CRITIQUE=10
# PLAN_FREE_COVERLETTER=2
# PLAN_FREE_LINKEDIN=2
# PLAN_PRO_TAILORING=50
# PLAN_PRO_CRITIQUE=100
# PLAN_PRO_COVERLETTER=25
# PLAN_PRO_LINKEDIN=25
# PLAN_PREMIUM_TAILORING=500
# PLAN_PREMIUM_CRITIQUE=1000
# PLAN_PREMIUM_COVERLETTER=250
# PLAN_PREMIUM_LINKEDIN=250

# --- Billing (optional; app boots and works fully without it) --------------
# STRIPE_SECRET_KEY=sk_live_or_test_key
# Stripe recurring price IDs for each paid plan (create in the Stripe dashboard):
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_PREMIUM=price_xxx
# Signing secret of the billing webhook endpoint:
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (optional; defaults to console provider in development) ---------
# EMAIL_PROVIDER=resend        # console | resend | sendgrid
# EMAIL_FROM=Curevo AI <noreply@yourdomain.com>
# EMAIL_API_KEY=

# --- Job discovery source (optional; honest 503 without it) ----------------
# Any JSON job-listing API. '{query}' is replaced with the URL-encoded search
# term; the response may be an array or nest jobs under jobs/results/data.
# JOBS_API_URL=https://jobs-api.example.com/search?q={query}
# JOBS_API_KEY=

# --- Company research web search (optional; sourced facts only) ------------
# Without it, company research returns an honest configuration error rather
# than AI-invented company facts.
# RESEARCH_SEARCH_API_URL=https://search.example.com/api?q={query}
# RESEARCH_SEARCH_API_KEY=

# --- Monitoring (optional; safe console logging without it) ----------------
# SENTRY_DSN=https://<publicKey>@<host>/<projectId>

# --- Legacy-compatible alias (still honoured) -----------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Upload limits ---------------------------------------------------------
# MAX_UPLOAD_BYTES=8388608
